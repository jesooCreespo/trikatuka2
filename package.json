{
  "name": "trikatuka",
  "version": "3.0.0-alpha.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "i18n:sync": "node scripts/sync-locales.mjs",
    "prestart": "npm run i18n:sync",
    "start": "ng serve",
    "prebuild": "npm run i18n:sync",
    "build": "ng build",
    "pretest": "npm run i18n:sync",
    "test": "ng test --no-watch && npm run test:locales",
    "test:watch": "ng test",
    "test:locales": "node --test \"scripts/**/*.test.mjs\"",
    "test:e2e": "playwright test",
    "screenshots": "playwright test -c playwright.screenshots.config.ts",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.3.0",
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@ng-icons/core": "^36.1.0",
    "@ng-icons/lucide": "^36.1.0",
    "@spartan-ng/brain": "^1.10.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.9.1"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.2",
    "vitest": "^5.1.2"
  },
  "allowScripts": {
    "@parcel/watcher": false,
    "esbuild": false,
    "lmdb": false,
    "msgpackr-extract": false
  }
}
