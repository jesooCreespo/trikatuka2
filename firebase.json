{
  "hosting": {
    "public": "dist",
    "predeploy": ["npm run build"],
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "redirects": [
      {
        "source": "/privacypolicy.html",
        "destination": "/privacy",
        "type": 301
      },
      {
        "source": "/privacypolicy",
        "destination": "/privacy",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/afterLogin",
        "destination": "/afterLogin.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
